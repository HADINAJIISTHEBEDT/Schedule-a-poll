# Preferred: free MongoDB Atlas for WhatsApp login + contacts (no Disk / Storage upgrade)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/pollscheduler?retryWrites=true&w=majority
WA_REMOTE_AUTH=true

# Optional Firebase (polls). Contacts/login prefer Mongo when MONGODB_URI is set.
USE_FIREBASE=true
FIREBASE_PROJECT_ID=poll-generator-f6697
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@poll-generator-f6697.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
