# Default = LocalAuth on disk (same as localhost)
# DATA_DIR=/app/data on Render Disk → login at /app/data/whatsapp-session
# DATA_DIR unset locally → login at ./data/whatsapp-session
WA_REMOTE_AUTH=false

# Optional Firebase (polls / extra contact copy). Not required for WhatsApp login.
# USE_FIREBASE=true
# FIREBASE_PROJECT_ID=poll-generator-f6697
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@poll-generator-f6697.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional Firestore/Mongo RemoteAuth (NOT same as localhost — only if you want it):
# WA_REMOTE_AUTH=true
# WA_SESSION_BACKEND=mongodb
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/pollscheduler
