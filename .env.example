# Firebase (polls in Firestore + WhatsApp login backup in Storage — no Render Disk needed)
USE_FIREBASE=true
FIREBASE_PROJECT_ID=poll-generator-f6697
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@poll-generator-f6697.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=poll-generator-f6697.firebasestorage.app
WA_REMOTE_AUTH=true

# Or point to a service account JSON file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json
